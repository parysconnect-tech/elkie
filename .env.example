# =====================================================================
# Elkie Web Studio — Environment Variables
# Copy this file to `.env.local` and fill in the values you have.
# Anything left blank just disables the related feature — the app
# still runs end-to-end with stubs.
# =====================================================================

# ---------- Supabase (auth, database, realtime) ----------
# Get these from https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — server-side only (Edge Functions). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe (payments, test mode for now) ----------
# Get these from https://dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each plan (create in Stripe dashboard, paste IDs here)
VITE_STRIPE_PRICE_STARTER=
VITE_STRIPE_PRICE_CUSTOM=
VITE_STRIPE_PRICE_PRO=

# ---------- Resend (transactional email, called from Supabase Edge Functions) ----------
# Get from https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@elkie.com
RESEND_FROM_NAME=Elkie Web Studio

# Where to send new lead notifications
ADMIN_NOTIFICATION_EMAIL=

# ---------- Cloudflare Turnstile (invisible CAPTCHA on lead form + signup) ----------
# Get from https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Google Analytics ----------
VITE_GA_MEASUREMENT_ID=G-1CG236C3N9

# ---------- WhatsApp (floating button) ----------
VITE_WHATSAPP_NUMBER=
